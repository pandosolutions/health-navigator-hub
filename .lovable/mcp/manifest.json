{
  "version": 1,
  "sdk_version": "0.25.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://jbysznesovucpsgfvpko.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "health-navigator-hub",
      "version": "0.1.0",
      "title": "Health Navigator Hub"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Return the signed-in user's account profile: username, email and phone number.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "update_my_profile",
        "title": "Update my profile",
        "description": "Update the signed-in user's username and/or phone number. Omitted fields are left unchanged.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "username": {
              "description": "New username.",
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            },
            "phone": {
              "description": "New phone number.",
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_my_health_data",
        "title": "Get my health data",
        "description": "Return the signed-in user's health record: age, gender, body fat percentage, skeletal muscle mass and lab values. Read-only — only an admin can change health data.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "search_nutrition_index",
        "title": "Search the nutrition index",
        "description": "Search the site's nutrition index for foods by name or category, returning macros, key nutrients and notes.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Text to match against name or category.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "limit": {
              "description": "Maximum rows to return (default 25, max 100).",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_saved_readings",
        "title": "List my saved readings",
        "description": "Return the topics the signed-in user has bookmarked.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "save_reading",
        "title": "Save a reading",
        "description": "Bookmark a topic for the signed-in user by its slug.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "topic_slug": {
              "type": "string",
              "minLength": 1,
              "description": "Topic slug, e.g. 'superfoods'."
            },
            "topic_title": {
              "description": "Display title for the topic.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "topic_slug"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
