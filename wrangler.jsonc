// Cloudflare Worker for moringatherapeutics.com. `npm run build` writes the
// Worker to .output/, then `npm run deploy` uploads it. Private keys are
// Cloudflare secrets (npx wrangler secret put NAME), never in this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moringa",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  // Cloudflare creates the DNS records and certificates for these on deploy.
  "routes": [
    { "pattern": "moringatherapeutics.com", "custom_domain": true },
    { "pattern": "www.moringatherapeutics.com", "custom_domain": true }
  ],
  // Public settings only.
  "vars": {
    "SUPABASE_URL": "https://dvcjunywbslizbbyergg.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_6Kf4t1sAiZwATfI8skG6KQ_7KsvaW4m"
  }
}
